[Unit]
Description=Hearth privileged helper (Docker and app-file operations for the Hearth daemon)
Documentation=https://github.com/SpiritEXEWasTaken/hearth
After=docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/hearth helper --daemon-user hearth
Restart=on-failure
RestartSec=5
RuntimeDirectory=hearth-helper
RuntimeDirectoryMode=0755

# The helper runs as root. It reads Docker sockets, /run/user/*/docker.sock and /var/lib/casaos/apps,
# and writes only Hearth's own folders (/var/lib/hearth/apps, /var/backups/hearth) and, for a
# restore, the data folders of the app being restored. /usr, /boot and /etc stay read-only.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# docker compose (run for app changes) may use netlink and IP sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# CAP_DAC_OVERRIDE/READ_SEARCH: reach users' rootless sockets and data folders owned by others.
# CAP_CHOWN/FOWNER/FSETID: hand sockets and files to the hearth group; restore file ownership.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_FSETID
AmbientCapabilities=
# Includes docker compose child processes during pulls.
MemoryMax=512M

[Install]
WantedBy=multi-user.target
