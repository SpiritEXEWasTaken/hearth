{"entry":{"id":"org.example.whoami","name":"Whoami","summary":"A tiny web page that shows the request (store test entry)","description":"Answers every request with what it received. Used by Hearth's tests.\n\nSecond paragraph.\n","category":"other","upstream":{"website":"https://github.com/traefik/whoami","source":"https://github.com/traefik/whoami"},"license":"Apache-2.0","icon":"icon.svg","screenshots":[{"file":"screenshots/1.png","caption":"The test page","source":"own"}],"app_name":"whoami","web":{"service":"web","port_env":"WEB_PORT","path":"/","https":"recommended","dashboard":true},"requirements":{"ram_mb":16,"data_mb":1,"architectures":["amd64","arm64"],"gpu":"none","host_network":false},"notice":"No test data is included.","ports":[{"env":"WEB_PORT","port":18082,"protocol":"tcp","label":"Web page","movable":true}],"env":{"SECRET_WORD":{"generate":"password","show_as":"Secret word"}},"options":[{"id":"greeting","kind":"choice","label":"Greeting","default":"hello","choices":[{"id":"hello","label":"Hello"},{"id":"verbose","label":"Verbose logging","variants":["verbose"]}]}],"data_dirs":[{"path":"data","owner":"root"}],"after_install":["Open the page to see your request."]},"compose":"services:\n  web:\n    image: traefik/whoami:latest\n    environment:\n      WHOAMI_NAME: ${SECRET_WORD}\n    volumes:\n      - ${APP_DATA}/data:/data\n    ports:\n      - \"${WEB_PORT}:80\"\n    restart: unless-stopped\n","variants":{"verbose":"services:\n  web:\n    command: [\"--verbose\"]\n"},"files":{"screenshots/1.png":"e66d50d044958fe767a1c3446f0a87f236f2927e2b493f88644c322f6efaf32f"},"images":[]}